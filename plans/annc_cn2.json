    {"page": "10002", "contexts": ["normal"], "lines": "all",
     "dest": "voice-l044/10002/normal/{line}.ogg", "tts_text": "@t"},
    {"page": "10002", "contexts": ["comm"], "lines": "all",
     "dest": "voice/10002/comm/{line}.ogg", "tts_text": "@t"},
    {"page": "10002", "contexts": ["comm"], "lines": "all",
     "dest": "voice-l044/10002/comm/{line}.ogg", "tts_text": "@t"},
    {"page": "10099", "contexts": ["station_broadcast"], "lines": "all",
     "dest": "voice/10099/station_broadcast/{line}.ogg", "tts_text": "@t"},
    {"page": "10099", "contexts": ["station_broadcast"], "lines": "all",
     "dest": "voice-l044/10099/station_broadcast/{line}.ogg", "tts_text": "@t"}
  ],
  "sound_library_redirect": [
    {"id": "10002_normal",         "sample": "extensions\\x4_annc_cn\\voice\\10002\\normal"},
    {"id": "10002_comm",           "sample": "extensions\\x4_annc_cn\\voice\\10002\\normal"},
    {"id": "10002_comm_broadcast", "sample": "extensions\\x4_annc_cn\\voice\\10002\\comm"},
    {"id": "10099_normal",         "sample": "extensions\\x4_annc_cn\\voice\\10099\\station_broadcast"},
    {"id": "10099_comm_broadcast", "sample": "extensions\\x4_annc_cn\\voice\\10099\\station_broadcast"}
  ]
